{
  "name": "lensiq-backend",
  "version": "0.1.0",
  "private": true,
  "description": "LENSIQ Cloudflare Worker + D1: admin back office, privacy-first analytics, AI fortune proxy, billing scaffold (FREE_MODE)",
  "license": "MIT",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "build:admin": "node scripts/build-admin.mjs",
    "predev": "node scripts/build-admin.mjs",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply lensiq --local",
    "db:migrate:remote": "node ../tools/backend-deploy.mjs migrate",
    "deploy": "node ../tools/backend-deploy.mjs deploy",
    "test": "cd .. && node --test tests/unit/backend-*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
