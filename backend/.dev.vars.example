# Copy to backend/.dev.vars for `wrangler dev` (git-ignored). PLACEHOLDERS ONLY — never commit real keys.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-string-at-least-32-chars
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEK=replace-with-base64-of-32-random-bytes
# AI gateway keys (docs/AI-GATEWAY.md §3a). Production: `npx wrangler secret put <NAME>`. Check them with
# `npm run -s ai:keycheck` (prints provider + OK/FAIL + HTTP status only, never a key).
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
# Alibaba Singapore endpoint URL needs the workspace id (Model Studio console; not a secret, can be a plain [vars] entry):
# DASHSCOPE_WORKSPACE_ID=
# DEEPSEEK_API_KEY=
# ZAI_API_KEY=
# KIMI_API_KEY=
# OPENROUTER_API_KEY=
# OPN_SECRET_KEY=skey_test_...
# OPN_PUBLIC_KEY=pkey_test_...
# OPN_WEBHOOK_SECRET=
ALLOWED_ORIGINS=http://localhost:8000
# Local development only: skip Turnstile for http://localhost origins (refused for any other origin)
TURNSTILE_DISABLED_FOR_LOCAL_DEV=true
