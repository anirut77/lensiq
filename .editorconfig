# .editorconfig — editor defaults for LENSIQ. `npm run format:check` (tools/format-check.mjs) enforces the same rules
# on the lines a change adds, so the existing code is never mass-reformatted.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,mjs,cjs,ts,css,html,json,yml,yaml}]
max_line_length = 160

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[{vendor/**,data/**,*.min.js,*.min.css}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
max_line_length = off
