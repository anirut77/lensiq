#!/bin/sh
# tools/git-hooks/pre-commit — optional local hook (owner decision 111): blocks a commit whose staged lines hold personal
# data (coordinates, postcode + city, phone, Thai ID, public IP, street address) or a forbidden path (.wrangler/,
# .dev.vars, .env). Values are never printed. Enable once per clone:
#   git config core.hooksPath tools/git-hooks
# (or copy this file to .git/hooks/pre-commit). Disable: git config --unset core.hooksPath. CI runs the same scanner.
cd "$(git rev-parse --show-toplevel)" && exec node tools/pii-scan.mjs --staged
