{
  "//": "tsc --checkJs over the shared platform modules (JSDoc types, no build step, nothing emitted). Run: npm run typecheck. Add a file to `files` once it type-checks cleanly.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": false,
    "noImplicitThis": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  },
  "files": [
    "types/lensiq-globals.d.ts",
    "lensiq-i18n.js",
    "lensiq-agg.js",
    "lensiq-facevault.js",
    "nav.js",
    "home.js",
    "i18n/zh-common.js"
  ]
}
